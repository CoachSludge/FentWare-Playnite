<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">

    <Style TargetType="{x:Type MainWindow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MainWindow}">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        d:DesignWidth="1280" d:DesignHeight="960">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Storyboard x:Key="VisibilityOn">
                                    <ThicknessAnimationUsingKeyFrames
                                        Storyboard.TargetProperty="Margin"
                                        Storyboard.TargetName="PART_Notifications">
                                        <SplineThicknessKeyFrame KeyTime="00:00:00"
                                            Value="-260,0,0,0" />
                                        <SplineThicknessKeyFrame KeyTime="0:0:0.10" Value="0,0,0,0" />
                                    </ThicknessAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="VisibilityOff">
                                    <ThicknessAnimationUsingKeyFrames
                                        Storyboard.TargetProperty="Margin"
                                        Storyboard.TargetName="PART_Notifications">
                                        <SplineThicknessKeyFrame KeyTime="00:00:00" Value="0,0,0,0" />
                                        <SplineThicknessKeyFrame KeyTime="0:0:0.10"
                                            Value="-260,0,0,0" />
                                    </ThicknessAnimationUsingKeyFrames>
                                </Storyboard>
                            </Grid.Resources>

                            <DockPanel>
                                <Sidebar x:Name="PART_Sidebar" Panel.ZIndex="999"
                                    DockPanel.Dock="{Settings SidebarPosition}" />
                                <!-- FentWare hero: keep the required content host and all Playnite controls intact. -->
                                <Grid DockPanel.Dock="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Margin="26,18,26,8" Padding="18,16,18,14"
                                            CornerRadius="20" Background="{DynamicResource FentGlass}"
                                            BorderBrush="{DynamicResource FentGlassLine}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" HorizontalAlignment="Center"
                                                       Text="FENTWARE / PLAYNITE" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource FentTextMuted}"
                                                       Margin="0,0,0,10"/>
                                            <Image Grid.Row="1"
                                                   Source="{ThemeFile 'Images/fentware/fenttext_still_img_transparent.jpg'}"
                                                   Height="138" MaxWidth="660" Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                                <Border Width="38" Height="1" Background="{DynamicResource FentGlassLine}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="YOUR GAMES  /  YOUR LIBRARY" FontSize="10"
                                                           Foreground="{DynamicResource FentTextMuted}" />
                                                <Border Width="38" Height="1" Background="{DynamicResource FentGlassLine}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ContentControl Name="PART_ContentView" Grid.Row="1" />
                                </Grid>
                            </DockPanel>
                            <NotificationPanel x:Name="PART_Notifications"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Width="260"
                                Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                AnimatedVisibility.Visibility="{Settings NotificationPanelVisible}"
                                AnimatedVisibility.Visible="{StaticResource VisibilityOn}"
                                AnimatedVisibility.Collapsed="{StaticResource VisibilityOff}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>